* text=auto eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.bat text eol=crlf
*.png binary
*.ico binary
*.exe binary

# Unified diffs use leading spaces for context, including blank Go lines.
scripts/dlx-handoff-*.patch -whitespace

# Test fixtures are byte-exact (CRLF, trailing spaces, BOM-free UTF-8): never normalise them.
tests/fixtures/** -text
tests/fixtures/*.pdf binary
