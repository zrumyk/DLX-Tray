# Copy to .env for local development. .env is never committed.
# In the installed app, the DeepL API key is entered in Settings and stored
# in Windows Credential Manager; values here only override it during development.

# Official DeepL API key (Free keys end with ":fx"). Used as a fallback when DLX fails.
DLX_DEEPL_API_KEY=

# Force a fixed port for the bundled DLX server (empty = pick a free port).
DLX_DEEPLX_PORT=

# Use an external DLX server instead of the bundled one, e.g. http://127.0.0.1:1188
DLX_DEEPLX_URL=

# DEBUG, INFO, WARNING, ERROR
DLX_LOG_LEVEL=INFO
